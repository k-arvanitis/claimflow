# LLM backend — use "anthropic" (default) or "openai" for local vLLM
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_MODEL=claude-sonnet-4-6

# doc-intel passthrough
DOC_INTEL_PROVIDER=anthropic
DOC_INTEL_MODEL=claude-sonnet-4-6
DOC_INTEL_LLM_BASE_URL=
OPENAI_API_KEY=your-openai-key-here

# Qdrant
QDRANT_URL=http://localhost:6339
QDRANT_COLLECTION=claimflow_policies

# Decision thresholds
CONFIDENCE_THRESHOLD=0.75
ESCALATION_THRESHOLD=0.50

# Langfuse tracing (optional — set LANGFUSE_ENABLED=true to activate)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
